{
  "expo": {
    "name": "وصلة شحن",
    "slug": "wasla-shahn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "waslashahn",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.waslashahn.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "وصلة شحن محتاجة موقعك علشان توريك أقرب شاحن شغّال."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A111F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.waslashahn.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A111F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "وصلة شحن محتاجة موقعك علشان توريك أقرب شاحن شغّال."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22D3EE"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "وصلة شحن محتاجة الكاميرا علشان تصوّر الشاحن مع البلاغ.",
          "photosPermission": "وصلة شحن محتاجة الصور علشان تضيف صورة الشاحن للبلاغ."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A111F",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}